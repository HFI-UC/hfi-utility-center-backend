{
  "name": "hfiuc-outbox-consumer",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "vars": {
    "DISPATCH_ENABLED": "false",
    "PHP_API_BASE_URL": "https://api.hfiuc.org",
    "PHP_PROCESS_URL": "https://api.hfiuc.org/internal/outbox/process"
  },
  "durable_objects": {
    "bindings": [
      { "name": "TASK_DISPATCHER", "class_name": "TaskDispatcher" }
    ]
  },
  "migrations": [
    { "tag": "task-dispatcher-v1", "new_sqlite_classes": ["TaskDispatcher"] }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "queues": {
    "producers": [
      { "binding": "TASK_QUEUE", "queue": "uc" }
    ],
    "consumers": [
      {
        "queue": "uc",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 8,
        "retry_delay": 10
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "hfiuc-outbox-consumer-dev",
      "vars": {
        "DISPATCH_ENABLED": "false",
        "PHP_API_BASE_URL": "https://preview-api.hfiuc.org",
        "PHP_PROCESS_URL": "https://preview-api.hfiuc.org/internal/outbox/process"
      },
      "durable_objects": {
        "bindings": [
          { "name": "TASK_DISPATCHER", "class_name": "TaskDispatcher" }
        ]
      },
      "migrations": [
        { "tag": "task-dispatcher-v1", "new_sqlite_classes": ["TaskDispatcher"] }
      ],
      "triggers": {
        "crons": ["* * * * *"]
      },
      "queues": {
        "producers": [
          { "binding": "TASK_QUEUE", "queue": "uc-dev" }
        ],
        "consumers": [
          {
            "queue": "uc-dev",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 8,
            "retry_delay": 10
          }
        ]
      }
    }
  }
}
